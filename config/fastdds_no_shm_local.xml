<?xml version="1.0" encoding="UTF-8" ?>
<!--
Loopback-only twin of fastdds_no_shm.xml, used while remote_dds is off (the
default): interface whitelist and initial peer are 127.0.0.1, so nothing is
announced off this machine. ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST must not be
paired with it: that adds the shared-memory transport back (measured 2026-11-06).

UDP-only transport profile (no shared-memory transport). passthrough_odom_publisher
hangs in rcl_node_init -> FastDDS SharedMemTransport::CreateInputChannelResource
on startup once /dev/shm accumulates many stale fastrtps_* segments from prior
SIGKILLed runs; the hang happens before rclpy.spin() even starts, so
SIGINT/SIGTERM are never handled. Same fix and same root cause as
thornbots_pkg/config/fastdds_udp_only.xml (its high-level publishers);
kept as this package's own copy rather than reaching into thornbots_pkg's share
dir, since it's a small static file and this package has no other dependency
on thornbots_pkg. Applied to just this node via FASTRTPS_DEFAULT_PROFILES_FILE
in localization.launch.py.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_only</transport_id>
                <type>UDPv4</type>
                <maxInitialPeersRange>32</maxInitialPeersRange>
                <interfaceWhiteList>
                    <address>127.0.0.1</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="udp_only_participant" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_only</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <initialPeersList>
                        <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
