"""Launch-time gate: exec EKF only after a fresh raw odometry seed exists."""

import argparse
import json
import math
import os
import sys
import time


WAIT_SECONDS = 15.0
MAX_AGE_SECONDS = 0.5


def initial_state(message, now_ns):
    """Reject unstamped, stale, future or nonfinite raw positions."""
    stamp = message.header.stamp
    stamp_ns = stamp.sec * 1_000_000_000 + stamp.nanosec
    age_ns = now_ns - stamp_ns
    position = message.pose.pose.position
    if (stamp_ns <= 0 or not 0 <= age_ns <= MAX_AGE_SECONDS * 1e9
            or not math.isfinite(position.x) or not math.isfinite(position.y)):
        return None
    return [float(position.x), float(position.y)] + [0.0] * 13


def wait_for_seed(use_sim_time, require_team=False, explicit_team=None):
    """Wait on ROS time freshness with a monotonic wall-time deadline."""
    import rclpy
    from nav_msgs.msg import Odometry
    from rclpy.parameter import Parameter
    from rclpy.qos import qos_profile_sensor_data

    rclpy.init(args=[])
    node = rclpy.create_node('ekf_seed_waiter', parameter_overrides=[
        Parameter('use_sim_time', value=use_sim_time)])
    seed = None
    team = None if explicit_team is None else explicit_team == 'blue'
    team_since_ns = None

    def receive_team(message):
        nonlocal team, team_since_ns
        observed = bool(message.is_on_blue_team) if message.robot_id else None
        if observed != team:
            team = observed
            team_since_ns = node.get_clock().now().nanoseconds

    def receive(message):
        nonlocal seed
        if seed is None:
            candidate = initial_state(message, node.get_clock().now().nanoseconds)
            if candidate is None:
                return
            if require_team or explicit_team is not None:
                stamp = message.header.stamp
                stamp_ns = stamp.sec * 1_000_000_000 + stamp.nanosec
                if team is None or (require_team and stamp_ns <= team_since_ns):
                    return
                start_x = 4.625 if team else -4.625
                if math.hypot(candidate[0] - start_x, candidate[1]) > 0.3:
                    return
            seed = candidate

    # Volatile, best effort accepts both reliable and best-effort raw publishers.
    subscription = node.create_subscription(Odometry, '/odom', receive, qos_profile_sensor_data)
    team_subscription = None
    if require_team:
        from dji_serial_bridge.msg import RefSysStatus
        team_subscription = node.create_subscription(
            RefSysStatus, '/dji_serial_bridge/ref_sys', receive_team, qos_profile_sensor_data)
    deadline = time.monotonic() + WAIT_SECONDS
    requirement = ('referee team and subsequent fresh raw /odom at its start'
                   if require_team else 'fresh raw /odom')
    node.get_logger().info(f'Waiting up to 15 s for {requirement} before starting EKF')
    try:
        while rclpy.ok() and seed is None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError(f'No {requirement} within 15 s; EKF was not started')
            rclpy.spin_once(node, timeout_sec=min(0.1, remaining))
        if seed is None:
            raise RuntimeError('ROS shut down before raw /odom seed; EKF was not started')
        return seed
    except (TimeoutError, RuntimeError) as error:
        node.get_logger().error(str(error))
        raise
    finally:
        if team_subscription is not None:
            node.destroy_subscription(team_subscription)
        node.destroy_subscription(subscription)
        node.destroy_node()
        rclpy.try_shutdown()


def main(argv=None):
    """Preserve launch's EKF parameters/remaps, overriding only initial_state."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seed-use-sim-time', choices=['true', 'false'], required=True)
    parser.add_argument('--require-team', action='store_true')
    parser.add_argument('--team', choices=['red', 'blue'])
    options, ros_arguments = parser.parse_known_args(argv)
    try:
        from ament_index_python.packages import get_package_prefix

        seed = wait_for_seed(options.seed_use_sim_time == 'true', options.require_team, options.team)
        executable = os.path.join(
            get_package_prefix('robot_localization'), 'lib', 'robot_localization', 'ekf_node')
        command = [executable, *ros_arguments]
        if '--ros-args' not in ros_arguments:
            command.append('--ros-args')
        command.extend(['-p', 'initial_state:=' + json.dumps(seed)])
        os.execvp(command[0], command)
    except (TimeoutError, RuntimeError, OSError) as error:
        print(f'seeded_ekf: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
